# Copy to .env and fill in. NEVER commit .env (CONTRACT §37).

DATABASE_URL=postgresql+psycopg2://merchantops:merchantops@127.0.0.1:5432/merchantops

# --- LLM ---------------------------------------------------------------
# auto          use Anthropic if a key is present, otherwise the deterministic planner
# anthropic     force the real model
# deterministic force the deterministic planner (used for reproducible evaluation)
LLM_PROVIDER=auto
LLM_MODEL=claude-opus-5
LLM_EFFORT=medium
# ANTHROPIC_API_KEY=sk-ant-...

# --- Razorpay ----------------------------------------------------------
# auto            live_test_mode if credentials are present, else mock
# live_test_mode  real Razorpay Test Mode
# mock            deterministic local adapter
# Run scripts/razorpay_spike.py before trusting live_test_mode.
RAZORPAY_MODE=auto
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxx

# --- Agent execution budget (CONTRACT §10) -----------------------------
MAX_TOOL_CALLS_PER_TASK=12
MAX_LLM_TURNS_PER_TASK=8
MAX_WALL_CLOCK_SECONDS=60

# --- Policy ------------------------------------------------------------
REFUND_AMOUNT_LIMIT_MINOR=500000
APPROVAL_TTL_SECONDS=900
