# Copy to .env and fill in. NEVER commit .env (CONTRACT §37).

DATABASE_URL=postgresql+psycopg2://merchantops:merchantops@127.0.0.1:5432/merchantops

# --- LLM ---------------------------------------------------------------
# auto          use Anthropic if ANY credential the SDK accepts is present --
#               ANTHROPIC_API_KEY, ANTHROPIC_AUTH_TOKEN, an `ant auth login`
#               profile, or workload identity -- otherwise the deterministic
#               planner. /health reports which source was found.
# anthropic     force the real model
# deterministic force the deterministic planner (used for reproducible evaluation)
LLM_PROVIDER=auto
LLM_MODEL=claude-opus-5
LLM_EFFORT=medium
# A ceiling on any single model call. The loop also passes its own remaining
# budget per turn, so this bounds the case where that is still too generous --
# without it one hung request holds a database transaction open for as long as
# the transport allows.
LLM_TIMEOUT_SECONDS=30
# Transient provider failures are absorbed rather than failing the task. This
# and the timeout above are one budget between them: the deadline is divided
# across attempts, so raising retries shortens each attempt rather than
# extending the call.
LLM_MAX_RETRIES=2
# ANTHROPIC_API_KEY=sk-ant-...

# --- Razorpay ----------------------------------------------------------
# auto            live_test_mode if credentials are present, else mock
# live_test_mode  real Razorpay Test Mode
# mock            deterministic local adapter
# Run scripts/razorpay_spike.py before trusting live_test_mode.
RAZORPAY_MODE=auto
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxx

# Webhook signing secret (MerchantOps §34). Chosen by you in the Razorpay
# dashboard when creating the endpoint -- deliberately NOT the API key secret,
# so that one leak does not compromise both directions.
#
# UNSET: /webhooks/razorpay still records every delivery, but never acts on one.
# An unverified event can never change state. /health reports which mode is live.
# RAZORPAY_WEBHOOK_SECRET=whsec_xxxxxxxx

# --- Agent execution budget (CONTRACT §10) -----------------------------
MAX_TOOL_CALLS_PER_TASK=12
MAX_LLM_TURNS_PER_TASK=8
MAX_WALL_CLOCK_SECONDS=60

# What the HOST allows one invocation, which is a different question from what
# we would like to spend. Leave unset on a long-lived server -- nothing outside
# the process is holding a stopwatch. Set it wherever something is, and keep it
# equal to that limit: the agent's deadline is then held inside it with a margin
# (see ADR-0029), so a run aborts cleanly with its trace instead of being killed
# mid-transaction.
#
# On Vercel this defaults to `functions."api/index.py".maxDuration` from
# vercel.json. Change one, change the other.
# PLATFORM_TIMEOUT_SECONDS=60

# --- Observability (ADR-0031) ------------------------------------------
# Structured logs go to stdout, which every platform ingests. `json` is the
# default; `text` is for a terminal.
LOG_LEVEL=INFO
LOG_FORMAT=json
# httpx/anthropic log every outbound call at INFO, which is one line per request
# on top of ours. Raise to INFO for a debugging session.
# LOG_LEVEL_HTTP=WARNING
# A query slower than this is logged with its statement (never its parameters).
SLOW_QUERY_MS=250

# Runtime metrics for a scraper at GET /metrics/prometheus. A scraper has no
# merchant and is not given one: this is a shared secret sent as
# `Authorization: Bearer <token>`, not a user token.
#
# UNSET: the route returns 404. Metrics publish route names, traffic shape and
# error rates, which is a small leak and still a leak, so it is not served to
# anyone by default.
# METRICS_SCRAPE_TOKEN=

# --- Policy ------------------------------------------------------------
REFUND_AMOUNT_LIMIT_MINOR=500000
APPROVAL_TTL_SECONDS=900
