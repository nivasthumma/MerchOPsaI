__pycache__/
*.py[cod]
.venv/
venv/
.env
*.log
.pytest_cache/
data/evaluation_report.json
# Same reasoning: a measurement OF a tree, not a property of one.
# Committing it would version a stale number and start a merge conflict
# per run. `scripts/check_counts.py` reads it where it is produced.
data/mutation_report.json
data/mutation_report_web.json
.mutation-in-progress
.vercel
.vercel_python_packages/
.env*

# Vite's local transform cache.
web/.vite/

# Running vitest or npm from the repository root instead of `web/` leaves a
# stray cache here. There is no npm project at the root; anything under this
# name is an accident, and one that would otherwise be offered for commit.
node_modules/

# Vitest coverage output. A measurement of a tree, like the evaluation and
# mutation reports -- regenerated by `npx vitest run --coverage`, never a source.
web/coverage/

# Claude Code's local state. `.claude/worktrees/` holds registered git
# worktrees of THIS repository -- a second checkout, 138 MB of it -- so
# committing this directory would commit the repository into itself. Tooling
# state, like `.venv/`: local to whoever is working here.
.claude/
