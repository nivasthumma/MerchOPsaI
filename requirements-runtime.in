httpx==0.28.1
# The reasoning provider. A container with no ANTHROPIC_* credential runs the
# deterministic planner and never imports this -- but the image should be able
# to do either, since which one is chosen is a runtime decision (`/health`
# reports which), not a build-time one.
anthropic==1.0.0
