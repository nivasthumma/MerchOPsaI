# Copy to .env and fill in. NEVER commit .env (CONTRACT §37).

DATABASE_URL=postgresql+psycopg2://merchantops:merchantops@127.0.0.1:5432/merchantops

# --- LLM ---------------------------------------------------------------
# auto          use Anthropic if ANY credential the SDK accepts is present --
#               ANTHROPIC_API_KEY, ANTHROPIC_AUTH_TOKEN, an `ant auth login`
#               profile, or workload identity -- otherwise the deterministic
#               planner. /health reports which source was found.
# anthropic     force the real model
# deterministic force the deterministic planner (used for reproducible evaluation)
LLM_PROVIDER=auto
LLM_MODEL=claude-opus-5
LLM_EFFORT=medium
# A ceiling on any single model call. The loop also passes its own remaining
# budget per turn, so this bounds the case where that is still too generous --
# without it one hung request holds a database transaction open for as long as
# the transport allows.
LLM_TIMEOUT_SECONDS=30
# Transient provider failures are absorbed rather than failing the task. This
# and the timeout above are one budget between them: the deadline is divided
# across attempts, so raising retries shortens each attempt rather than
# extending the call.
LLM_MAX_RETRIES=2
# ANTHROPIC_API_KEY=sk-ant-...

# --- Razorpay ----------------------------------------------------------
# auto            live_test_mode if credentials are present, else mock
# live_test_mode  real Razorpay Test Mode
# mock            deterministic local adapter
# Run scripts/razorpay_spike.py before trusting live_test_mode.
RAZORPAY_MODE=auto
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxx

# Webhook signing secret (MerchantOps §34). Chosen by you in the Razorpay
# dashboard when creating the endpoint -- deliberately NOT the API key secret,
# so that one leak does not compromise both directions.
#
# UNSET: /webhooks/razorpay still records every delivery, but never acts on one.
# An unverified event can never change state. /health reports which mode is live.
# RAZORPAY_WEBHOOK_SECRET=whsec_xxxxxxxx

# --- Agent execution budget (CONTRACT §10) -----------------------------
MAX_TOOL_CALLS_PER_TASK=12
MAX_LLM_TURNS_PER_TASK=8
MAX_WALL_CLOCK_SECONDS=60

# What the HOST allows one invocation, which is a different question from what
# we would like to spend. Leave unset on a long-lived server -- nothing outside
# the process is holding a stopwatch. Set it wherever something is, and keep it
# equal to that limit: the agent's deadline is then held inside it with a margin
# (see ADR-0029), so a run aborts cleanly with its trace instead of being killed
# mid-transaction.
#
# On Vercel this defaults to `functions."api/index.py".maxDuration` from
# vercel.json. Change one, change the other.
# PLATFORM_TIMEOUT_SECONDS=60

# --- Observability (ADR-0031) ------------------------------------------
# Structured logs go to stdout, which every platform ingests. `json` is the
# default; `text` is for a terminal.
LOG_LEVEL=INFO
LOG_FORMAT=json
# httpx/anthropic log every outbound call at INFO, which is one line per request
# on top of ours. Raise to INFO for a debugging session.
# LOG_LEVEL_HTTP=WARNING
# A query slower than this is logged with its statement (never its parameters).
SLOW_QUERY_MS=250

# Runtime metrics for a scraper at GET /metrics/prometheus. A scraper has no
# merchant and is not given one: this is a shared secret sent as
# `Authorization: Bearer <token>`, not a user token.
#
# UNSET: the route returns 404. Metrics publish route names, traffic shape and
# error rates, which is a small leak and still a leak, so it is not served to
# anyone by default.
# METRICS_SCRAPE_TOKEN=

# --- Authentication ----------------------------------------------------
# The HMAC key that bearer tokens are signed with.
#
# UNSET on a laptop: a development default is used so a fresh clone runs with
# no configuration. UNSET on a deployment: the application REFUSES TO START.
# That default is a literal in app/api/security.py, so anyone who can read this
# repository could otherwise mint a token for any user -- the permission checks
# behind the token are real, the identity in front of them would not be.
#
# "A deployment" means a platform marker is present (VERCEL, AWS_EXECUTION_ENV,
# KUBERNETES_SERVICE_HOST, DYNO, RENDER, FLY_APP_NAME, WEBSITE_INSTANCE_ID) or
# MERCHANTOPS_ENV is production/staging. Set MERCHANTOPS_ALLOW_DEV_SECRET=1 to
# override deliberately.
#
#   API_TOKEN_SECRET=$(python -c "import secrets; print(secrets.token_urlsafe(48))")
# API_TOKEN_SECRET=

# Names this environment when no platform sets a marker of its own.
# MERCHANTOPS_ENV=production

# --- Policy ------------------------------------------------------------
REFUND_AMOUNT_LIMIT_MINOR=500000
APPROVAL_TTL_SECONDS=900

# --- Operator notifications (ADR-0042) ---------------------------------
# Which channels a notification goes out on, comma-separated. `log` is always
# available and is the default: it writes the recipient, subject and full body
# as a structured line, so a deployment with no SMTP can still answer "was the
# approver told, and what did it say?".
#
# A name here that is not configured is a STARTUP ERROR, not a silent fallback.
# The failure this package exists to prevent is somebody believing they are
# being emailed when they are not.
# NOTIFY_CHANNELS=log,email

# How far ahead of an approval's expiry to chase it. Must be less than
# APPROVAL_TTL_SECONDS (900) or the chase never fires. Note that the sweep that
# sends it needs a caller -- `make notify`, on a cadence of a couple of minutes.
# NOTIFY_APPROVAL_WARNING_SECONDS=300

# Nothing below this severity is sent. INFO | WARNING | CRITICAL.
# NOTIFY_MIN_SEVERITY=INFO

# Where links in a notification point. Unset means relative paths, which are
# useless in an email.
# NOTIFY_BASE_URL=https://merchantops.example.com

# SMTP. Both SMTP_HOST and NOTIFY_EMAIL_FROM are required for the `email`
# channel to exist at all. Credentials are optional -- a relay inside a VPC
# often has none.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# NOTIFY_EMAIL_FROM=merchantops@example.com

# A Slack incoming webhook. The URL is the credential AND names the channel, so
# delivery is to that channel rather than per-person.
# SLACK_WEBHOOK_URL=

# A JSON POST to a URL you own -- PagerDuty, Opsgenie, a ticket queue. Signed
# with HMAC-SHA256 in X-MerchantOps-Signature when a secret is set, the same
# shape as the Razorpay signature we verify inbound.
# NOTIFY_WEBHOOK_URL=
# NOTIFY_WEBHOOK_SECRET=

# --- Shared state (ADR-0044) -------------------------------------------
# Where the rate-limit counter and the runtime provider override live.
#
# UNSET is a supported configuration, not a broken one: both fall back to
# process memory, which is exact on a laptop and in a single-container stack.
# It is wrong the moment there are two API processes -- N replicas then serve N
# times the configured rate limit -- and on a serverless host, where every
# invocation may be a new process, the in-process counter is not an approximate
# limit but no limit at all.
#
# `/health` reports `shared_state.backend` as `shared`, `degraded` or `process`,
# so which one is live is never a guess. `degraded` means this is set and Redis
# is not answering: the limiter has fallen back per-process rather than failing
# requests, and that is visible rather than silent.
#
# Nothing here is persisted on purpose -- see the redis service in
# docker-compose.yml.
# REDIS_URL=redis://localhost:6379/0

# --- Agent execution (ADR-0045) ----------------------------------------
# `inline` runs a task inside the request that created it and returns the
# finished task. It is the only thing possible where there is no worker -- a
# serverless deployment, or a bare `make api` -- and it is the default so that
# nothing which works today stops working.
#
# `async` writes the task, returns 202 with its id, and lets a worker run it.
# That is what removes the request timeout from the design: an investigation can
# take as long as its budget allows without a proxy giving up. It REQUIRES a
# worker -- `POST /tasks` returns 503 rather than queueing into a void when none
# has reported in recently.
#
# `POST /tasks?mode=inline|async` overrides per request either way.
# AGENT_EXECUTION_MODE=async

# --- Tokens (ADR-0049) -------------------------------------------------
# How long an access token lives. Short enough that a copy stops working on its
# own; long enough that a working session is not a stream of refreshes.
# AUTH_ACCESS_TOKEN_SECONDS=3600

# How long "stay signed in" lasts. This is the window in which a stolen refresh
# token is useful -- bounded by single-use rotation and replay detection rather
# than by being short.
# AUTH_REFRESH_TOKEN_SECONDS=2592000

# Accept the pre-ADR-0049 `user_id.signature` tokens, which never expire and
# cannot be revoked individually. OFF by default. Turn it on for the length of a
# rollout and then off again -- `/health` reports it, because a deployment that
# left it on has expiry and revocation that anybody holding an old token can opt
# out of.
# AUTH_ACCEPT_LEGACY_TOKENS=false

# Rotating the signing key without a flag day: move the old value here, put the
# new one in API_TOKEN_SECRET, deploy. Tokens already in the wild keep verifying
# until they expire. Then remove this.
# API_TOKEN_SECRET_PREVIOUS=

# --- Single sign-on (ADR-0050) -----------------------------------------
# Nothing to set here. A tenant's identity provider is configured through the
# API by its owner (`PUT /sso`), because the issuer, client id and secret belong
# to the customer rather than to this deployment -- and a second tenant would
# need a second set.
#
# The redirect URI to register at the provider is this deployment's
#     <base>/api/auth/sso/callback
# derived from the request rather than configured, so it cannot drift from what
# the authorization request actually sent.
